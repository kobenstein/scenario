# Copy to .env and fill in your own values. Never commit .env (it is in .gitignore).
# Load into your shell with:  set -a; source .env; set +a

# YouTube Data API + Analytics API (OAuth client of type "Desktop app" in Google Cloud,
# with the YouTube Data API v3 and YouTube Analytics API enabled). Used by tools/check_descriptions.py,
# tools/yt_analytics.py and the upload skill.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Optional: plain API key for public lookups (kanalanalyse/kanalanalyse.py)
YT_API_KEY=

# fal.ai: voice (ElevenLabs via fal), music, sound effects, images
FAL_KEY=

# Optional: where the working folder of running films lives (tools/sync_projektordner.py)
SCENARIO_PROJEKTORDNER=
